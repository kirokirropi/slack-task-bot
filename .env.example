# Copy to .env and fill in.
# Bot token (OAuth & Permissions page), starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token with connections:write (Basic Information > App-Level Tokens), starts with xapp-
SLACK_APP_TOKEN=xapp-your-app-token
# Channel IDs (right-click channel > View channel details > bottom of the About tab)
TASKS_CHANNEL_ID=C0123456789
ALERTS_CHANNEL_ID=C0987654321
